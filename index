            <h3 class="text-2xl font-bold text-stone-900">مختارات آية فاشون</h3>
        </div>

        <!-- Filter Categories Buttons -->
        <div class="flex gap-2 overflow-x-auto pb-2 text-xs font-medium no-scrollbar">
            <button onclick="filterCategory('all', this)" class="filter-btn filter-btn-active px-4 py-2 rounded-md whitespace-nowrap transition cursor-pointer">وصل حديثًا</button>
            <button onclick="filterCategory('women', this)" class="filter-btn filter-btn-inactive px-4 py-2 rounded-md whitespace-nowrap transition cursor-pointer">نساء</button>
            <button onclick="filterCategory('men', this)" class="filter-btn filter-btn-inactive px-4 py-2 rounded-md whitespace-nowrap transition cursor-pointer">رجال</button>
            <button onclick="filterCategory('accessories', this)" class="filter-btn filter-btn-inactive px-4 py-2 rounded-md whitespace-nowrap transition cursor-pointer">إكسسوارات</button>
