                <div class="relative bg-stone-200 aspect-[3/4] overflow-hidden rounded-sm">
                    <button class="absolute top-2 left-2 w-7 h-7 bg-white/80 rounded-sm flex items-center justify-center text-stone-700 text-xs z-10">♡</button>
                    <img src="https://images.unsplash.com/photo-1617137984095-74e4e5e3613f?auto=format&fit=crop&q=80&w=600" class="w-full h-full object-cover">
                </div>
                <div class="flex justify-between items-baseline">
                    <h4 class="product-title text-xs font-medium text-stone-800">بولو محبوك ناعم</h4>
                    <span class="text-xs font-bold text-stone-900">96 $</span>
                </div>
                <select class="w-full bg-white border border-stone-300 rounded-sm py-1 px-2 text-xs text-stone-700 appearance-none">
                    <option>متوسط</option>
                </select>
                <select class="w-full bg-white border border-stone-300 rounded-sm py-1 px-2 text-xs text-stone-700 appearance-none">
                    <option>فحمي</option>
                </select>
                <button onclick="addToCart('بولو محبوك ناعم', 96, 'https://images.unsplash.com/photo-1617137984095-74e4e5e3613f?auto=format&fit=crop&q=80&w=600')" class="w-full bg-white border border-stone-300 py-1.5 rounded-sm text-xs text-stone-800 flex items-center justify-center gap-2 hover:bg-stone-50">
                    🛍️ أضيفي إلى السلة
                </button>
            </div>

            <!-- Item 4 (Women) -->
            <div class="product-card space-y-2" data-category="women">
                <div class="relative bg-stone-200 aspect-[3/4] overflow-hidden rounded-sm">
                    <span class="absolute top-2 right-2 bg-white/90 text-[10px] px-2 py-0.5 rounded-sm font-medium text-stone-800 z-10">وصل للتو</span>
                    <button class="absolute top-2 left-2 w-7 h-7 bg-white/80 rounded-sm flex items-center justify-center text-stone-700 text-xs z-10">♡</button>
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=600" class="w-full h-full object-cover">
                </div>
                <div class="flex justify-between items-baseline">
                    <h4 class="product-title text-xs font-medium text-stone-800">جاكيت مفصّل يومي</h4>
                    <span class="text-xs font-bold text-stone-900">175 $</span>
                </div>
                <select class="w-full bg-white border border-stone-300 rounded-sm py-1 px-2 text-xs text-stone-700 appearance-none">
                    <option>متوسط</option>
                </select>
                <select class="w-full bg-white border border-stone-300 rounded-sm py-1 px-2 text-xs text-stone-700 appearance-none">
                    <option>جملي</option>
                </select>
                <button onclick="addToCart('جاكيت مفصّل يومي', 175, 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=600')" class="w-full bg-white border border-stone-300 py-1.5 rounded-sm text-xs text-stone-800 flex items-center justify-center gap-2 hover:bg-stone-50">
                    🛍️ أضيفي إلى السلة
