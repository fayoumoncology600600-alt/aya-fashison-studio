<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>آية فاشون - Aya Fashion Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #FAF8F5; color: #262626; }
        .cart-slide { transition: transform 0.3s ease-in-out; }
        .cart-hidden { transform: translateX(-100%); }
        .cart-visible { transform: translateX(0); }
        .filter-btn-active { background-color: #26211E !important; color: #ffffff !important; }
        .filter-btn-inactive { background-color: #ffffff !important; color: #44403c !important; border: 1px solid #e7e5e4 !important; }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Header / Navigation -->
    <header class="sticky top-0 z-40 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-stone-200/60 px-5 py-3 flex justify-between items-center">
        <button id="menu-btn" class="text-2xl text-stone-800 leading-none">☰</button>
        <h1 class="text-2xl font-bold tracking-wider text-stone-900">آية فاشون</h1>
        <button id="cart-btn" class="relative text-2xl text-stone-800">
            🛍️
